/run/numberOfThreads 8

# Физика и модели сольватации
/process/dna/e-SolvationSubType Meesungnoen2002
/process/dna/UseDNAMultipleIonisation true
/process/chem/TimeStepModel IRT_syn

/run/initialize

# Время измерения, как в статье Ямашиты (100 ns)
/scheduler/endTime 100 ns
/scorer/species/nOfTimeBins 50

# Достаточно большой фантом, чтобы частица управлялась через eLoss, а не геометрией
/primaryKiller/setSize 100 100 100 um
/gun/position 0 0 0 um
/gun/direction 0 0 1
/gun/particle ion
/gun/ion 2 4 2

/tracking/verbose 0
/scheduler/verbose 0
/run/printProgress 100

# ==============================================================================
# ДИАПАЗОН 1: Ультранизкие энергии (50 кэВ - 400 кэВ)
# Область спада за пиком Брэгга. Пробег микроскопический, поэтому eLossMin минимален.
# ==============================================================================
/primaryKiller/eLossMin 150 eV
/primaryKiller/eLossMax 450 eV

/gun/energy 0.05 MeV
/run/beamOn 4000

/gun/energy 0.08 MeV
/run/beamOn 4000

/gun/energy 0.10 MeV
/run/beamOn 4000

/gun/energy 0.15 MeV
/run/beamOn 4000

/gun/energy 0.20 MeV
/run/beamOn 4000

/gun/energy 0.30 MeV
/run/beamOn 4000

/gun/energy 0.40 MeV
/run/beamOn 4000


# ==============================================================================
# ДИАПАЗОН 2: Пик Брэгга (0.5 МэВ - 2 МэВ)
# Максимальный LET (до 230 кэВ/мкм). Плотная сетка для фиксации экстремума.
# ==============================================================================
/primaryKiller/eLossMin 600 eV
/primaryKiller/eLossMax 1800 eV

/gun/energy 0.50 MeV
/run/beamOn 3000

/gun/energy 0.65 MeV
/run/beamOn 3000

/gun/energy 0.80 MeV
/run/beamOn 3000

/gun/energy 1.00 MeV
/run/beamOn 3000

/gun/energy 1.25 MeV
/run/beamOn 3000

/gun/energy 1.50 MeV
/run/beamOn 3000

/gun/energy 1.75 MeV
/run/beamOn 3000


# ==============================================================================
# ДИАПАЗОН 3: Средние энергии (2 МэВ - 20 МэВ)
# Переходный диапазон (LET от 150 до 30 кэВ/мкм).
# ==============================================================================
/primaryKiller/eLossMin 2 keV
/primaryKiller/eLossMax 6 keV

/gun/energy 2.0 MeV
/run/beamOn 2500

/gun/energy 3.0 MeV
/run/beamOn 2500

/gun/energy 5.0 MeV
/run/beamOn 2500

/gun/energy 7.0 MeV
/run/beamOn 2500

/gun/energy 10.0 MeV
/run/beamOn 2500

/gun/energy 15.0 MeV
/run/beamOn 2500

/gun/energy 20.0 MeV
/run/beamOn 2500


# ==============================================================================
# ДИАПАЗОН 4: Высокие энергии (30 МэВ - 400 МэВ)
# Соответствует экспериментам HIMAC/NIRS (Yamashita et al., до 100-150 МэВ/нуклон).
# Низкий LET, треки длинные.
# ==============================================================================
/primaryKiller/eLossMin 5 keV
/primaryKiller/eLossMax 15 keV

/gun/energy 30.0 MeV
/run/beamOn 2000

/gun/energy 50.0 MeV
/run/beamOn 2000

/gun/energy 80.0 MeV
/run/beamOn 2000

/gun/energy 120.0 MeV
/run/beamOn 2000

/gun/energy 200.0 MeV
/run/beamOn 2000

/gun/energy 300.0 MeV
/run/beamOn 2000

/gun/energy 400.0 MeV
/run/beamOn 2000