#

/run/numberOfThreads 8
/process/dna/e-SolvationSubType Meesungnoen2002
#/process/dna/e-SolvationSubType Ritchie1994
#/process/dna/e-SolvationSubType Terrisol1990

# use Step-by-Step (SBS), independent reaction time (IRT)
# or synchronized IRT (IRT_syn),
# SBS ( is only for TDC, set 0 )
#/process/chem/TimeStepModel IRT
/process/dna/UseDNAMultipleIonisation true
#/process/chem/TimeStepModel SBS
/process/chem/TimeStepModel IRT_syn

#/process/em/verbose 1
#/scheduler/verbose 1

/run/initialize

/chem/reaction/print

# in order to reproduce LET values of NIST data
# please see the spower example using stationary mode

# select cutoff energy for restricted LET
#/scorer/LET/cutoff 100 eV

#/scorer/species/addTimeToRecord 1 ps
#/scorer/species/addTimeToRecord 10 ps
#/scorer/species/addTimeToRecord 100 ps        
#/scorer/species/addTimeToRecord 1 ns       
#/scorer/species/addTimeToRecord 10 ns       
#/scorer/species/addTimeToRecord 100 ns
#/scorer/species/addTimeToRecord 1 us

/scorer/species/nOfTimeBins 50

/tracking/verbose 0
/scheduler/verbose 0
/scheduler/endTime 100 ns

/run/printProgress 1

/primaryKiller/setSize 1000 1000 1000 nm
/gun/position  0 0 -500 nm
/gun/direction 0 0 1
/gun/particle ion
/gun/ion 2 4 2

/gun/energy 0.001 MeV
/run/beamOn 8
/gun/energy 0.01 MeV
/run/beamOn 8
/gun/energy 0.1 MeV
/run/beamOn 8
/gun/energy 0.5 MeV
/run/beamOn 8
/gun/energy 1.0 MeV
/run/beamOn 8
/gun/energy 2.0 MeV
/run/beamOn 8
/gun/energy 5.0 MeV
/run/beamOn 8
/gun/energy 10 MeV
/run/beamOn 8
/gun/energy 15 MeV
/run/beamOn 8
/gun/energy 20 MeV
/run/beamOn 8
/gun/energy 30 MeV
/run/beamOn 8
/gun/energy 40 MeV
/run/beamOn 8
/gun/energy 50 MeV
/run/beamOn 8
/gun/energy 80 MeV
/run/beamOn 8
/gun/energy 100 MeV
/run/beamOn 8
/gun/energy 150 MeV
/run/beamOn 8
/gun/energy 200 MeV
/run/beamOn 8