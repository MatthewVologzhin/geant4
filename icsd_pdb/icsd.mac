#/control/execute vis.mac
#/tracking/verbose 0
/run/printProgress 1
/physics/setPhysics G4EmDNAPhysics_option2
/det/setGeom 1kx5
/det/setGeomMethod BOOLEAN
/det/setVoxelSize 2 nm
/icsd/analysis/setFileName output/root
/det/setDataDir output/csv
/run/initialize

/gun/particle ion
/gun/ion 1 1 1
/gun/energy 1 MeV
/run/beamOn 1
