#/control/execute vis.mac
#/tracking/verbose 0
/run/numberOfThreads 1
/run/printProgress 1
/run/verbose 2
/control/verbose 2
#/icsd/setGeom nanodosimeter
/physics/setPhysics G4EmDNAPhysics_option8
/det/setGeom Histone
/det/setGeomMethod VOXEL
/det/setVoxelSize 2 nm
/icsd/analysis/setFileName check/check
/run/initialize

/gun/particle ion
/gun/ion 2 4 2
/gun/energy 1 MeV
/run/beamOn 1
