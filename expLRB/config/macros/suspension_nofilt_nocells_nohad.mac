# scenario=suspension_nofilt_nocells_nohad geometry=no_filter sample=suspension_nocells physics=nohad scoring=standard run=production beam=ne20_1gev
/control/verbose 1
/run/verbose 1
/run/numberOfThreads 10
/run/printProgress 2000
# --- Physics (PreInit) ---
/physics/setHadronic none
/physics/enableHadronic false
/physics/setEM EM_Opt4
/physics/enableDNAActivator true
# --- Output and target ---
/bio/output/fileName output/root/suspension_nofilt_nocells_nohad.root
/bio/score/profile standard
/bio/score/target medium
# --- World ---
/expLRB/det/setWorldZ 10 cm
