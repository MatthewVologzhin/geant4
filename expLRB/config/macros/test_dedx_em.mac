# AUTO-GENERATED by scripts/gen_macros.sh from config/runs.conf — edit the config, not this file.
# scenario=test_dedx_em geometry=dedx sample=dedx_water_em physics=had_nodna scoring=standard run=validation beam=ne20_800mev
/control/verbose 1
/run/verbose 1
/run/numberOfThreads 2
/run/printProgress 10
# --- Physics (PreInit) ---
/physics/setHadronic QGSP_BIC_HP
/physics/enableHadronic true
/physics/setEM EM_Opt4
/physics/enableDNAActivator false
# --- Output and target ---
/bio/output/fileName output/root/test_dedx_em.root
/bio/score/profile standard
/bio/score/target medium
# --- World ---
/expLRB/det/setWorldZ 100 mm
# --- Materials (LRB JINR data) ---
# --- Beam tract ---
# --- Biolayer ---
/bio/layer/create G4_WATER 0
/bio/layer/size 14 14 0.010 mm
/bio/layer/pos 0 0 0 mm
/bio/layer/physics none
# --- Beam ---
/run/initialize
/gun/particle ion
/gun/ion 10 20 10
/gun/energy 800 MeV
# Event count is resolved by /bio/run/beamOn (override with --events N)
/bio/run/setEvents 1000
/bio/run/beamOn
