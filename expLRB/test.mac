# ==============================================================================
# ШАГ 1. МНОГОПОТОЧНОСТЬ И ВЕРБОЗНОСТЬ
# ==============================================================================
/control/verbose 1
/run/verbose 1
/run/numberOfThreads 10
/run/printProgress 1000

# ==============================================================================
# ШАГ 2. НАСТРОЙКА ФИЗИКИ (СТРОГО PreInit ДО /run/initialize)
# ==============================================================================
# Доступные опции: QGSP_BIC_HP, FTFP_BERT_HP, QBBC, INCLXX_HP, none
/physics/setHadronic QGSP_BIC_HP

# Включение/отключение адронных реакций: true (вкл), false (выкл)
/physics/enableHadronic true

# Базовая EM физика вне ДНК-регионов: EM_Opt4, emstandard_opt0
/physics/setEM EM_Opt4

# Geant4-DNA активатор: true, false
/physics/enableDNAActivator true

# ==============================================================================
# ШАГ 3. ВЫХОДНОЙ ROOT-ФАЙЛ И МИШЕНЬ СКОРИНГА (СТРОГО PreInit)
# ==============================================================================
/bio/output/fileName lrb_test_output.root

# Доступные опции: nucleus, cytoplasm, membrane, cell, medium
/bio/score/target nucleus

# ==============================================================================
# ШАГ 4. ХИМИЧЕСКИЙ СОСТАВ И МАТЕРИАЛЫ (ДАННЫЕ ЛРБ ОИЯИ)
# ==============================================================================
/expLRB/det/setWorldZ 10 cm

# Ядро клетки: R = 3.1 мкм, плотность 1.0 г/см3
/expLRB/material/create Nucleus 1.0 g/cm3 5
/expLRB/material/add G4_H 0.3545
/expLRB/material/add G4_O 0.1518
/expLRB/material/add G4_C 0.2912
/expLRB/material/add G4_N 0.1899
/expLRB/material/add G4_P 0.0126

# Цитоплазма: толщина 0.5 мкм, плотность 1.0 г/см3
/expLRB/material/create Cytoplasm 1.0 g/cm3 5
/expLRB/material/add G4_H 0.5942
/expLRB/material/add G4_O 0.2437
/expLRB/material/add G4_C 0.1118
/expLRB/material/add G4_N 0.0403
/expLRB/material/add G4_P 0.0100

# Клеточная мембрана: толщина 10 нм, плотность 1.1 г/см3
/expLRB/material/create Membrane 1.1 g/cm3 4
/expLRB/material/add G4_H 0.4000
/expLRB/material/add G4_O 0.2000
/expLRB/material/add G4_C 0.2000
/expLRB/material/add G4_N 0.2000

# Внеклеточная среда RPMI-1640: плотность 1.0145 г/см3
/expLRB/material/create RPMI_1640 1.0145 g/cm3 10
/expLRB/material/add O  0.8653
/expLRB/material/add H  0.1098
/expLRB/material/add C  0.0121
/expLRB/material/add Cl 0.0048
/expLRB/material/add Na 0.0045
/expLRB/material/add N  0.0028
/expLRB/material/add P  0.0002
/expLRB/material/add S  0.0002
/expLRB/material/add K  0.0002
/expLRB/material/add Ca 0.0001

# ==============================================================================
# ШАГ 5. ГЕОМЕТРИЯ ЭКСПЕРИМЕНТАЛЬНОГО ТРАКТА У-400М
# Формат: /expLRB/det/addLayer <dx> <dy> <dz> <unit> <Material> <X> <Y> <Z> <unit>
# Поперечные размеры строго 14 x 14 мм! Координаты выверены без наложений!
# ==============================================================================
# 1. Контрольная мишень Ta (4 мкм)
/expLRB/det/addLayer 14 14 0.004 mm G4_Ta 0 0 0.00020 cm

# 2. Выходная фольга Fe (3 мкм)
/expLRB/det/addLayer 14 14 0.003 mm G4_Fe 0 0 0.00055 cm

# 3. Ионизационная камера (3 электрода Al по 5 мкм с зазорами воздуха по 6 мм)
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 0.00095 cm
/expLRB/det/addLayer 14 14 6.000 mm G4_AIR 0 0 0.30120 cm
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 0.60145 cm
/expLRB/det/addLayer 14 14 6.000 mm G4_AIR 0 0 0.90170 cm
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 1.20195 cm

# 4. Дополнительный фильтр Al (1.815 мм)
/expLRB/det/addLayer 14 14 1.815 mm G4_Al 0 0 1.29295 cm

# 5. Слой воздуха перед пробиркой (10 мм)
/expLRB/det/addLayer 14 14 10.00 mm G4_AIR 0 0 1.88370 cm

# 6. Стенка пробирки: полиэтилен (1.2 мм, rho = 0.94 г/см3)
/expLRB/det/addLayer 14 14 1.200 mm G4_POLYETHYLENE 0 0 2.44370 cm

# ==============================================================================
# ШАГ 6. БИОЛОГИЧЕСКИЙ ОБРАЗЕЦ И Geant4-DNA ФИЗИКА
# ==============================================================================
/bio/cell/geometry 3.1 0.5 0.01 um
/bio/cell/materials Nucleus Cytoplasm Membrane
/bio/cell/densities 1.0 1.0 1.1 g/cm3

# Дискретная физика в клетках: DNA_Opt0, DNA_Opt2, DNA_Opt4, DNA_Opt6, DNA_Opt8, none
/bio/cell/physics DNA_Opt6

# Биослой: suspension (4 мм) или monolayer (15 мкм).
# Для визуализации: 500 клеток (для полного расчета: 905000)
/bio/layer/create suspension RPMI_1640 905000
/bio/layer/size 14 14 4 mm
# Точный стык к стенке пробирки без наложения:
/bio/layer/pos 0 0 2.70370 cm

# ДНК-физика в окружающей питательной среде (дельта-электронное равновесие):
/bio/layer/physics none

# ==============================================================================
# ШАГ 7. ИНИЦИАЛИЗАЦИЯ (ПЕРЕХОД В G4State_Idle)
# ==============================================================================
/run/initialize

# ==============================================================================
# ШАГ 8. ПАРАМЕТРЫ ПУЧКА (НЕОН-20, 50 МэВ/нуклон -> 1.0 ГэВ)
# ==============================================================================
/gun/particle ion
/gun/ion 10 20 10
/gun/energy 1.0 GeV

# Радиус пятна 7 мм (диаметр 14 мм под апертуру фильтра):
/expLRB/gun/rndm 0

/run/beamOn 1000000