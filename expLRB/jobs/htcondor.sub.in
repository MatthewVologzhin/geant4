# HTCondor submit template for one expLRB configuration (generated by jobs/submit.sh).
# $(Cluster)$(Process) forms a submission-unique seed; each process writes its own chunk,
# so the chunks are independent and can be merged with hadd.
#
# Transfer mode is used because this pool's compute nodes have per-node FileSystemDomain
# values, which makes the default "shared filesystem" requirement
# (TARGET.FileSystemDomain == MY.FileSystemDomain) unsatisfiable. With
# should_transfer_files = YES the executable is left in place (transfer_executable = False)
# and the repository is expected to be visible on the node (getenv forwards the Geant4
# environment). The chunk written under output/raw is transferred back home.
universe                = vanilla
executable              = @@EXEC@@
arguments               = "@@BASE_MACRO@@ $(Cluster)$(Process) @@EVENTS@@ @@OUTDIR@@/@@TAG@@_$(Process).root @@THREADS@@"
initialdir              = @@ROOT@@
output                  = logs/expLRB_@@TAG@@_$(Process).out
error                   = logs/expLRB_@@TAG@@_$(Process).err
log                     = logs/expLRB_@@TAG@@.log
getenv                  = True
should_transfer_files   = YES
transfer_executable     = False
when_to_transfer_output = ON_EXIT
transfer_output_files   = output/raw
request_cpus            = @@THREADS@@
request_memory          = @@MEMORY@@
request_disk            = @@DISK@@
+JobBatchName           = "expLRB_@@TAG@@"
queue @@NJOBS@@
