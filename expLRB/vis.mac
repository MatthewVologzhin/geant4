# ==============================================================================
# ШАГ 1. МНОГОПОТОЧНОСТЬ И ВЕРБОЗНОСТЬ
# ==============================================================================
/control/verbose 1
/run/verbose 1
/run/numberOfThreads 1

# ==============================================================================
# ШАГ 2. НАСТРОЙКА ФИЗИКИ (СТРОГО PreInit ДО /run/initialize)
# ==============================================================================
# Доступные опции: QGSP_BIC_HP, FTFP_BERT_HP, QBBC, INCLXX_HP, none
/physics/setHadronic QGSP_BIC_HP

# Включение/отключение адронных реакций: true (вкл), false (выкл)
/physics/enableHadronic true

# Базовая EM физика вне ДНК-регионов: EM_Opt4, emstandard_opt0
/physics/setEM EM_Opt4

# Geant4-DNA активатор: true, false
/physics/enableDNAActivator true

# ==============================================================================
# ШАГ 3. ВЫХОДНОЙ ROOT-ФАЙЛ И МИШЕНЬ СКОРИНГА (СТРОГО PreInit)
# ==============================================================================
/bio/output/fileName lrb_vis_output.root

# Доступные опции: nucleus, cytoplasm, membrane, cell, medium
/bio/score/target nucleus

# ==============================================================================
# ШАГ 4. ХИМИЧЕСКИЙ СОСТАВ И МАТЕРИАЛЫ (ДАННЫЕ ЛРБ ОИЯИ)
# ==============================================================================
/expLRB/det/setWorldZ 10 cm

# Ядро клетки: R = 3.1 мкм, плотность 1.0 г/см3
/expLRB/material/create Nucleus 1.0 g/cm3 5
/expLRB/material/add G4_H 0.3545
/expLRB/material/add G4_O 0.1518
/expLRB/material/add G4_C 0.2912
/expLRB/material/add G4_N 0.1899
/expLRB/material/add G4_P 0.0126

# Цитоплазма: толщина 0.5 мкм, плотность 1.0 г/см3
/expLRB/material/create Cytoplasm 1.0 g/cm3 5
/expLRB/material/add G4_H 0.5942
/expLRB/material/add G4_O 0.2437
/expLRB/material/add G4_C 0.1118
/expLRB/material/add G4_N 0.0403
/expLRB/material/add G4_P 0.0100

# Клеточная мембрана: толщина 10 нм, плотность 1.1 г/см3
/expLRB/material/create Membrane 1.1 g/cm3 4
/expLRB/material/add G4_H 0.4000
/expLRB/material/add G4_O 0.2000
/expLRB/material/add G4_C 0.2000
/expLRB/material/add G4_N 0.2000

# Внеклеточная среда RPMI-1640: плотность 1.0145 г/см3
/expLRB/material/create RPMI_1640 1.0145 g/cm3 10
/expLRB/material/add O  0.8653
/expLRB/material/add H  0.1098
/expLRB/material/add C  0.0121
/expLRB/material/add Cl 0.0048
/expLRB/material/add Na 0.0045
/expLRB/material/add N  0.0028
/expLRB/material/add P  0.0002
/expLRB/material/add S  0.0002
/expLRB/material/add K  0.0002
/expLRB/material/add Ca 0.0001

# ==============================================================================
# ШАГ 5. ГЕОМЕТРИЯ ЭКСПЕРИМЕНТАЛЬНОГО ТРАКТА У-400М
# Формат: /expLRB/det/addLayer <dx> <dy> <dz> <unit> <Material> <X> <Y> <Z> <unit>
# Поперечные размеры строго 14 x 14 мм! Координаты выверены без наложений!
# ==============================================================================
# 1. Контрольная мишень Ta (4 мкм)
/expLRB/det/addLayer 14 14 0.004 mm G4_Ta 0 0 0.00020 cm

# 2. Выходная фольга Fe (3 мкм)
/expLRB/det/addLayer 14 14 0.003 mm G4_Fe 0 0 0.00055 cm

# 3. Ионизационная камера (3 электрода Al по 5 мкм с зазорами воздуха по 6 мм)
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 0.00095 cm
/expLRB/det/addLayer 14 14 6.000 mm G4_AIR 0 0 0.30120 cm
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 0.60145 cm
/expLRB/det/addLayer 14 14 6.000 mm G4_AIR 0 0 0.90170 cm
/expLRB/det/addLayer 14 14 0.005 mm G4_Al 0 0 1.20195 cm

# 4. Дополнительный фильтр Al (1.815 мм)
#/expLRB/det/addLayer 14 14 1.815 mm G4_Al 0 0 1.29295 cm

# 5. Слой воздуха перед пробиркой (10 мм)
/expLRB/det/addLayer 14 14 10.00 mm G4_AIR 0 0 1.88370 cm

# 6. Стенка пробирки: полиэтилен (1.2 мм, rho = 0.94 г/см3)
/expLRB/det/addLayer 14 14 1.200 mm G4_POLYETHYLENE 0 0 2.44370 cm

# ==============================================================================
# ШАГ 6. БИОЛОГИЧЕСКИЙ ОБРАЗЕЦ И Geant4-DNA ФИЗИКА
# ==============================================================================
/bio/cell/geometry 3.1 0.5 0.01 um
/bio/cell/materials Nucleus Cytoplasm Membrane
/bio/cell/densities 1.0 1.0 1.1 g/cm3

# Дискретная физика в клетках: DNA_Opt0, DNA_Opt2, DNA_Opt4, DNA_Opt6, DNA_Opt8, none
/bio/cell/physics DNA_Opt6

# Биослой: suspension (4 мм) или monolayer (15 мкм).
# Для визуализации: 500 клеток (для полного расчета: 905000)
/bio/layer/create suspension RPMI_1640 500
/bio/layer/size 14 14 4 mm
# Точный стык к стенке пробирки без наложения:
/bio/layer/pos 0 0 2.70370 cm

# ДНК-физика в окружающей питательной среде (дельта-электронное равновесие):
/bio/layer/physics none

# ==============================================================================
# ШАГ 7. ИНИЦИАЛИЗАЦИЯ (ПЕРЕХОД В G4State_Idle)
# ==============================================================================
/run/initialize

# ==============================================================================
# ШАГ 8. ПАРАМЕТРЫ ПУЧКА (НЕОН-20, 50 МэВ/нуклон -> 1.0 ГэВ)
# ==============================================================================
/gun/particle ion
/gun/ion 10 20 10
/gun/energy 1.3 GeV

# Радиус пятна 7 мм (диаметр 14 мм под апертуру фильтра):
/expLRB/gun/setRadius 7 mm

# ==============================================================================
# ШАГ 9. НАСТРОЙКА OPENGL (БЕЗ ТОРМОЗОВ: autoRefresh ВЫКЛЮЧЕН!)
# ==============================================================================
/vis/open OGL 1920x1080-0+0

# ВАЖНО: блокируем перерисовку на время применения всех команд настройки!
/vis/viewer/set/autoRefresh false

/vis/drawVolume
/vis/scene/add/extent -1.2 1.2 -1.2 1.2 -0.2 3.2 cm

/vis/viewer/set/background white
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/lightsVector 1 1 2

/vis/viewer/set/culling coveredDaughters false
/vis/viewer/set/culling invisible true

# Крупный план фильтров:
/vis/viewer/set/viewpointThetaPhi 70 25
/vis/viewer/set/upVector 0 1 0
/vis/viewer/zoom 2.6

# Скрываем World и воздух
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility logic_layer_G4_AIR 0 false

# Раскраска поглотителей:
/vis/geometry/set/colour logic_layer_G4_Ta 0 0.9 0.5 0.1 1.0
/vis/geometry/set/colour logic_layer_G4_Fe 0 0.3 0.3 0.8 1.0
/vis/geometry/set/colour logic_layer_G4_Al 0 0.2 0.7 0.8 1.0
/vis/geometry/set/colour logic_layer_G4_POLYETHYLENE 0 0.4 0.8 0.4 0.9

/vis/geometry/set/forceSolid logic_layer_G4_Ta 0 true
/vis/geometry/set/forceSolid logic_layer_G4_Fe 0 true
/vis/geometry/set/forceSolid logic_layer_G4_Al 0 true
/vis/geometry/set/forceSolid logic_layer_G4_POLYETHYLENE 0 true

# Прозрачная среда суспензии:
/vis/geometry/set/forceWireframe logic_biomedium 0 true
/vis/geometry/set/colour logic_biomedium 0 0.6 0.6 0.6 0.2

# Клетки:
/vis/geometry/set/forceWireframe logic_cell 0 true
/vis/geometry/set/colour logic_cell 0 0.1 0.7 0.2 0.3

/vis/geometry/set/forceWireframe logic_cytoplasm 0 true
/vis/geometry/set/colour logic_cytoplasm 0 0.2 0.5 0.9 0.3

/vis/geometry/set/forceSolid logic_nucleus 0 true
/vis/geometry/set/colour logic_nucleus 0 0.85 0.1 0.1 1.0

# Подписи прямо над слоями (Y = 0.95 см):
/vis/scene/add/text 0 0.95 0.00 cm 9 0 0 Ta/Fe
/vis/scene/add/text 0 0.95 0.60 cm 9 0 0 Ion Chamber (Al)
/vis/scene/add/text 0 0.95 1.29 cm 9 0 0 Al Filter (1.8mm)
/vis/scene/add/text 0 0.95 2.44 cm 9 0 0 Polyethylene
/vis/scene/add/text 0 0.95 2.70 cm 10 0 0 4mm Cell Suspension

# ==============================================================================
# ШАГ 10. ТРАЕКТОРИИ И ЦВЕТОВАЯ ПАЛИТРА
# ==============================================================================
/vis/scene/add/trajectories rich
/vis/modeling/trajectories/create/drawByParticleID

# Тяжелые частицы (адронная группа):
/vis/modeling/trajectories/drawByParticleID-0/set GenericIon magenta   # Пучок Ne-20 и осколки (Li, Be, B, C, N, O, F)
/vis/modeling/trajectories/drawByParticleID-0/set alpha yellow         # Альфа-частицы
/vis/modeling/trajectories/drawByParticleID-0/set He3 orange           # Гелий-3
/vis/modeling/trajectories/drawByParticleID-0/set proton blue          # Протоны отдачи и каскада
/vis/modeling/trajectories/drawByParticleID-0/set deuteron cyan        # Дейтроны
/vis/modeling/trajectories/drawByParticleID-0/set triton cyan          # Тритон
/vis/modeling/trajectories/drawByParticleID-0/set neutron gray         # Нейтроны

# Электромагнитная группа:
/vis/modeling/trajectories/drawByParticleID-0/set e- red               # Дельта-электроны
/vis/modeling/trajectories/drawByParticleID-0/set e+ magenta           # Позитроны
/vis/modeling/trajectories/drawByParticleID-0/set gamma green          # Гамма-кванты

# ==============================================================================
# ШАГ 11. ФИЛЬТРЫ ТРЕКОВ И КНОПКИ В GUI QT
# ==============================================================================
# Фильтр, убирающий электронный туман (оставляет только пучок и ядерные осколки):
/vis/filtering/trajectories/create/particleFilter ionFilter
/vis/filtering/trajectories/ionFilter/add GenericIon
/vis/filtering/trajectories/ionFilter/add alpha
/vis/filtering/trajectories/ionFilter/add He3
/vis/filtering/trajectories/ionFilter/add proton
/vis/filtering/trajectories/ionFilter/add deuteron
/vis/filtering/trajectories/ionFilter/add triton
/vis/filtering/trajectories/ionFilter/add neutron
/vis/filtering/trajectories/ionFilter/active false

# Создаем меню кнопок в окне Qt:
/gui/addMenu trackMenu "Вид треков"

# Кнопка: Показать абсолютно все треки (с морем дельта-электронов)
/gui/addButton trackMenu "1. Все треки (с e-)" "/vis/filtering/trajectories/ionFilter/active false"

# Кнопка: Показать только тяжелые ионы (Ne-20 + альфа + протоны + осколки без e-)
/gui/addButton trackMenu "2. Только ионы и осколки (без e-)" "/vis/filtering/trajectories/ionFilter/active true"

# Кнопка: Очистить и запустить 50 событий для накопления ядерных реакций
/gui/addButton trackMenu "3. Пуск 50 ионов (накопить реакции)" "/run/beamOn 50"

# Кнопка: Обновить сцену
/gui/addButton trackMenu "4. Обновить экран (Refresh)" "/vis/viewer/rebuild"

# Накапливаем до 50 событий на экране, чтобы увидеть редкие ядерные реакции:
/vis/scene/add/hits
/vis/scene/endOfEventAction accumulate 50

# ==============================================================================
# ШАГ 12. ФИНАЛЬНОЕ ВКЛЮЧЕНИЕ ОТРИСОВКИ (МГНОВЕННО, В ОДИН ПРОХОД!)
# ==============================================================================
/vis/viewer/set/autoRefresh true
/vis/viewer/refresh

/run/beamOn 100